NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Smart Contract Addresses (Update after deployment)
NEXT_PUBLIC_SEPOLIA_CAMPUS_COIN=
NEXT_PUBLIC_SEPOLIA_BADGE_NFT=
NEXT_PUBLIC_SEPOLIA_ECONOMY_MANAGER=

NEXT_PUBLIC_MAINNET_CAMPUS_COIN=
